# =============================================================================
# Garvit Buildtech — Environment Variables
# Copy to .env.local (never commit .env.local)
# =============================================================================

# --- Lead / SMTP ---
# All required for /api/lead to send emails.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=leads@yourdomain.com
SMTP_PASS=your-smtp-password
LEAD_TO_EMAIL=sales@yourdomain.com
LEAD_FROM_EMAIL="Garvit Buildtech <leads@yourdomain.com>"

# --- Analytics ---
# GTM container ID — safe to expose (no secrets inside)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# --- Maps ---
# Used only for the static map image in <MapFacade>.
# Restrict this key to your domain in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- CSP Reporting ---
# Optional: endpoint for Content-Security-Policy reports.
# Leave blank to disable. Use Report-Only first (Phase 7).
CSP_REPORT_URI=

# Preview is the default. Enable only after content/credentials pass validate:release.
SITE_RELEASE=false
# Production value — keep preview deployments blank so they fall back to data/site.json.
NEXT_PUBLIC_CANONICAL_BASE=https://garvitbuildtech.com

# --- Search Console verification (optional; add after GSC/Bing signup) ---
# Emits <meta name="google-site-verification"> / <meta name="msvalidate.01">
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Only enable behind Nginx which overwrites X-Real-IP; Node listens on loopback.
TRUST_PROXY=false
# Persistent private folder outside releases, writable only by the app user.
LEAD_FAILURE_DIR=/var/www/garvit/shared/lead-outbox
# Promote only after observing a clean CSP report window in staging.
CSP_ENFORCE=false
